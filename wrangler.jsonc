{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "darabiha-family",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PUBLIC_ORIGIN": "https://darabiha.com",
    "OWNER_EMAIL": "ramine@ramine.net",
    "ARCHIVE_NAME": "Darabiha",
    "ARCHIVE_NAME_FA": "دارابی",
    "ARCHIVE_TAGLINE": "A living record of the Darabi family, built together.",
    "ARCHIVE_PROMPT_CONTEXT": "This family's records are not in one language: the histories were written in Persian, part of the family lives in France, and the archive holds all of it. Expect Persian, French, and English, sometimes mixed in one document, and dates that may be Solar Hijri.",
    "APPLE_CLIENT_ID": "com.darabiha.family",
    "APPLE_TEAM_ID": "52WM463HR2",
    "APPLE_KEY_ID": "J6958HV8HB",
    "GOOGLE_CLIENT_ID": "50198009288-qfpf5kc7e0n51pvv8addlif4co5dnflu.apps.googleusercontent.com"
  },
  "assets": { "directory": "dist/client" },
  "routes": [
    { "pattern": "darabiha.com/*", "zone_name": "darabiha.com" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "darabiha-family",
      "database_id": "e0577177-db86-4e15-8db6-d85323117fa9"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "darabiha-family-files" }
  ],
  "observability": { "enabled": true }
}
